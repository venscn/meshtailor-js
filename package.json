{
  "name": "meshtailor-js",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @meshtailor/studio run dev",
    "build": "npm --workspace @meshtailor/studio run build && npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "npm --workspace @meshtailor/cli run start",
    "check": "npm run test && npm run build",
    "test:core": "node scripts/core-smoke.mjs",
    "test:layout": "node scripts/layout-smoke.mjs",
    "test:browser": "node scripts/studio-smoke.mjs",
    "check:full": "npm run check && npm run test:core && npm run test:complex && npm run test:unfold && npm run test:uv-worker && npm run test:layout && npm run test:unfold:browser && npm run test:browser && npm run test:parameterization && npm run test:atlas && npm run test:hinge && npm run test:uv-guards && npm run lab:build && npm run test:lab && npm run test:packing-large && npm run test:uv-progress && npm run test:uv-client && npm run test:uv-large && npm run test:uv-lifecycle:browser && npm run test:camera && npm run test:camera:browser && npm run test:relay && npm run test:relay:browser && npm run test:motion-time && npm run test:motion && npm run test:motion:browser && npm run test:regions && npm run test:slits && npm run test:large-charts && npm run test:seam-policy && npm run test:orientation && npm run test:fit-orientation && npm run test:large-charts:browser && npm run test:materials && npm run test:boundary-stitch && npm run test:source-layout && npm run test:compact-layout && npm run test:fragmentation && npm run test:materials:browser",
    "assets:generate": "node scripts/generate-examples.mjs",
    "assets:download": "tsx scripts/download-assets.ts",
    "test:complex": "node scripts/complex-smoke.mjs",
    "test:imports": "vitest run apps/studio/src/__tests__/importers.test.ts",
    "git:check": "node scripts/git-history-check.mjs",
    "test:git": "node --test scripts/tests/git-history-check.test.mjs",
    "test:unfold": "node scripts/unfold-smoke.mjs",
    "test:unfold:browser": "node scripts/unfold-browser-smoke.mjs",
    "test:uv-worker": "node scripts/uv-worker-smoke.mjs",
    "test:parameterization": "node scripts/parameterization-smoke.mjs",
    "test:atlas": "node scripts/atlas-smoke.mjs",
    "test:hinge": "node scripts/hinge-smoke.mjs",
    "test:uv-guards": "node scripts/unwrap-guards-smoke.mjs",
    "lab:build": "node scripts/build-unfold-lab.mjs",
    "lab:serve": "node scripts/serve-unfold-lab.mjs",
    "test:lab": "node scripts/lab-browser-smoke.mjs",
    "test:packing-large": "node scripts/packing-large-smoke.mjs",
    "test:uv-progress": "node scripts/uv-progress-smoke.mjs",
    "test:uv-client": "node scripts/uv-job-client-smoke.mjs",
    "test:uv-large": "node scripts/uv-large-worker-smoke.mjs",
    "test:uv-lifecycle:browser": "node scripts/uv-lifecycle-browser-smoke.mjs",
    "test:flight-helmet": "tsx scripts/flight-helmet-smoke.ts",
    "test:camera": "node scripts/camera-policy-smoke.mjs",
    "test:camera:browser": "node scripts/camera-browser-smoke.mjs",
    "test:relay": "node scripts/schedule-smoke.mjs",
    "test:relay:browser": "node scripts/relay-browser-smoke.mjs",
    "test:motion-time": "node scripts/motion-timing-smoke.mjs",
    "test:motion": "node scripts/motion-geometry-smoke.mjs",
    "test:motion:browser": "node scripts/motion-browser-smoke.mjs",
    "test:regions": "node scripts/regions-smoke.mjs",
    "test:slits": "node scripts/slits-smoke.mjs",
    "test:large-charts": "node scripts/large-charts-smoke.mjs",
    "test:seam-policy": "node scripts/seam-policy-smoke.mjs",
    "test:orientation": "node scripts/orientation-smoke.mjs",
    "test:fit-orientation": "node scripts/fit-orientation-smoke.mjs",
    "test:large-charts:browser": "node scripts/large-charts-browser-smoke.mjs",
    "test:materials": "node scripts/material-domain-smoke.mjs",
    "test:boundary-stitch": "node scripts/boundary-stitch-smoke.mjs",
    "test:source-layout": "node scripts/source-layout-smoke.mjs",
    "test:compact-layout": "node scripts/compact-layout-smoke.mjs",
    "test:fragmentation": "node scripts/fragmentation-smoke.mjs",
    "test:materials:browser": "node scripts/material-layout-browser-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "tsx": "^4.20.5"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
