    "test:selection:react": "node scripts/selection-react-smoke.mjs",
    "test:chart-merge": "node scripts/chart-merge-smoke.mjs",
    "test:atlas-pages": "node scripts/atlas-pages-smoke.mjs",
    "test:optimization-quality": "node scripts/optimization-quality-smoke.mjs",
    "test:optimization:browser": "node scripts/uv-optimization-browser-smoke.mjs",
    "test:overlap": "node scripts/overlap-policy-smoke.mjs",
    "test:overlap:browser": "node scripts/overlap-browser-smoke.mjs",
    "test:overlap:workbench": "node scripts/overlap-lab-browser-smoke.mjs",
    "test:area-allocation": "node scripts/area-allocation-smoke.mjs",
