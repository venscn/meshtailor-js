    "test:source-atlas": "node scripts/source-atlas-smoke.mjs",
    "test:area-spatial:browser": "node scripts/area-spatial-browser-smoke.mjs",
    "test:source-repair": "node scripts/source-repair-smoke.mjs",
    "test:chart-join": "node scripts/chart-join-smoke.mjs",
