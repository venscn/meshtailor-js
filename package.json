{
  "name": "meshtailor-js",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @meshtailor/studio run dev",
    "build": "npm --workspace @meshtailor/studio run build && npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "npm --workspace @meshtailor/cli run start",
    "check": "npm run test && npm run build",
    "test:core": "node scripts/core-smoke.mjs",
    "test:layout": "node scripts/layout-smoke.mjs",
    "test:browser": "node scripts/studio-smoke.mjs",
    "check:full": "npm run check && npm run test:core && npm run test:complex && npm run test:unfold && npm run test:uv-worker && npm run test:layout && npm run test:unfold:browser && npm run test:browser && npm run test:parameterization && npm run test:atlas && npm run test:hinge && npm run test:uv-guards && npm run lab:build && npm run test:lab && npm run test:packing-large && npm run test:uv-progress && npm run test:uv-client && npm run test:uv-large && npm run test:uv-lifecycle:browser && npm run test:camera && npm run test:camera:browser",
    "assets:generate": "node scripts/generate-examples.mjs",
    "assets:download": "tsx scripts/download-assets.ts",
    "test:complex": "node scripts/complex-smoke.mjs",
    "test:imports": "vitest run apps/studio/src/__tests__/importers.test.ts",
    "git:check": "node scripts/git-history-check.mjs",
    "test:git": "node --test scripts/tests/git-history-check.test.mjs",
    "test:unfold": "node scripts/unfold-smoke.mjs",
    "test:unfold:browser": "node scripts/unfold-browser-smoke.mjs",
    "test:uv-worker": "node scripts/uv-worker-smoke.mjs",
    "test:parameterization": "node scripts/parameterization-smoke.mjs",
    "test:atlas": "node scripts/atlas-smoke.mjs",
    "test:hinge": "node scripts/hinge-smoke.mjs",
    "test:uv-guards": "node scripts/unwrap-guards-smoke.mjs",
    "lab:build": "node scripts/build-unfold-lab.mjs",
    "lab:serve": "node scripts/serve-unfold-lab.mjs",
    "test:lab": "node scripts/lab-browser-smoke.mjs",
    "test:packing-large": "node scripts/packing-large-smoke.mjs",
    "test:uv-progress": "node scripts/uv-progress-smoke.mjs",
    "test:uv-client": "node scripts/uv-job-client-smoke.mjs",
    "test:uv-large": "node scripts/uv-large-worker-smoke.mjs",
    "test:uv-lifecycle:browser": "node scripts/uv-lifecycle-browser-smoke.mjs",
    "test:flight-helmet": "tsx scripts/flight-helmet-smoke.ts",
    "test:camera": "node scripts/camera-policy-smoke.mjs",
    "test:camera:browser": "node scripts/camera-browser-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "tsx": "^4.20.5"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
