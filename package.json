    "test:playback-emphasis:browser": "node scripts/playback-ghost-browser-smoke.mjs",
    "test:playback-session:browser": "node scripts/playback-session-browser-smoke.mjs",
    "test:arrival": "node scripts/arrival-presentation-smoke.mjs",
